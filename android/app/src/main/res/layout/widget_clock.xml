<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:id="@+id/widget_face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="스키아 시계">

        <FrameLayout
            android:id="@+id/widget_dial_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/dial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:src="@drawable/widget_background_7"
                android:scaleType="fitCenter"
                android:contentDescription="시계 배경" />

            <ImageView
                android:id="@+id/widget_idle_character"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_idle"
                android:scaleType="fitCenter"
                android:contentDescription="흔들리는 캐릭터" />

            <ImageView
                android:id="@+id/dial_markers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_markers_7"
                android:scaleType="fitCenter"
                android:contentDescription="시계 눈금과 숫자" />

            <AnalogClock
                android:id="@+id/hands"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/empty_dial"
                android:hand_hour="@drawable/hour_hand"
                android:hand_minute="@drawable/minute_hand" />

            <GridLayout
                android:id="@+id/widget_action_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="5"
                android:rowCount="5"
                android:orientation="horizontal"
                android:contentDescription="시계 위 투명한 5×5 방향 입력">

                <TextView android:id="@+id/widget_r0c0" style="@style/WidgetTouchTarget" android:layout_row="0" android:layout_column="0" />
                <TextView android:id="@+id/widget_r0c1" style="@style/WidgetTouchTarget" android:layout_row="0" android:layout_column="1" />
                <TextView android:id="@+id/widget_r0c2" style="@style/WidgetTouchTarget" android:layout_row="0" android:layout_column="2" />
                <TextView android:id="@+id/widget_r0c3" style="@style/WidgetTouchTarget" android:layout_row="0" android:layout_column="3" />
                <TextView android:id="@+id/widget_r0c4" style="@style/WidgetTouchTarget" android:layout_row="0" android:layout_column="4" />

                <TextView android:id="@+id/widget_r1c0" style="@style/WidgetTouchTarget" android:layout_row="1" android:layout_column="0" />
                <TextView android:id="@+id/widget_bonk_head_0" style="@style/WidgetTouchTarget" android:layout_row="1" android:layout_column="1" />
                <TextView android:id="@+id/widget_bonk_head_1" style="@style/WidgetTouchTarget" android:layout_row="1" android:layout_column="2" />
                <TextView android:id="@+id/widget_bonk_head_2" style="@style/WidgetTouchTarget" android:layout_row="1" android:layout_column="3" />
                <TextView android:id="@+id/widget_r1c4" style="@style/WidgetTouchTarget" android:layout_row="1" android:layout_column="4" />

                <TextView android:id="@+id/widget_r2c0" style="@style/WidgetTouchTarget" android:layout_row="2" android:layout_column="0" />
                <TextView android:id="@+id/widget_bonk_head_3" style="@style/WidgetTouchTarget" android:layout_row="2" android:layout_column="1" />
                <TextView android:id="@+id/widget_bonk_head_4" style="@style/WidgetTouchTarget" android:layout_row="2" android:layout_column="2" />
                <TextView android:id="@+id/widget_bonk_head_5" style="@style/WidgetTouchTarget" android:layout_row="2" android:layout_column="3" />
                <TextView android:id="@+id/widget_r2c4" style="@style/WidgetTouchTarget" android:layout_row="2" android:layout_column="4" />

                <TextView android:id="@+id/widget_r3c0" style="@style/WidgetTouchTarget" android:layout_row="3" android:layout_column="0" />
                <TextView android:id="@+id/widget_r3c1" style="@style/WidgetTouchTarget" android:layout_row="3" android:layout_column="1" />
                <TextView android:id="@+id/widget_r3c2" style="@style/WidgetTouchTarget" android:layout_row="3" android:layout_column="2" />
                <TextView android:id="@+id/widget_r3c3" style="@style/WidgetTouchTarget" android:layout_row="3" android:layout_column="3" />
                <TextView android:id="@+id/widget_r3c4" style="@style/WidgetTouchTarget" android:layout_row="3" android:layout_column="4" />

                <TextView android:id="@+id/widget_r4c0" style="@style/WidgetTouchTarget" android:layout_row="4" android:layout_column="0" />
                <TextView android:id="@+id/widget_r4c1" style="@style/WidgetTouchTarget" android:layout_row="4" android:layout_column="1" />
                <TextView android:id="@+id/widget_r4c2" style="@style/WidgetTouchTarget" android:layout_row="4" android:layout_column="2" />
                <TextView android:id="@+id/widget_r4c3" style="@style/WidgetTouchTarget" android:layout_row="4" android:layout_column="3" />
                <TextView android:id="@+id/widget_r4c4" style="@style/WidgetTouchTarget" android:layout_row="4" android:layout_column="4" />
            </GridLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
